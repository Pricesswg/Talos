# NOTE: custom_components/talos/vendor/ is generated by scripts/bundle.sh but
# is deliberately committed - HACS installs only what is under
# custom_components, so the bundled core has to be in the tree. CI fails if it
# drifts from talos_core/ at the root, which stays the single source of truth.
